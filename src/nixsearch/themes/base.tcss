#search-bar {
    dock: top;
    height: 3;
    width: 1fr;
}

#channel-select {
    width: 40;
}

#channel-select > SelectCurrent {
    border: none;
    height: 3;
    padding: 1 2;
}

#search-input {
    width: 1fr;
    margin: 0;
}

#search-results {
    height: 1fr;
    scrollbar-gutter: stable;
}

#detail-content {
    padding: 1 2;
}