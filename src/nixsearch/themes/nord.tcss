Screen {
    background: #2e3440;
    color: #eceff4;
}

Header {
    background: #3b4252;
    color: #88c0d0;
    dock: top;
    height: 1;
}

HeaderTitle {
    color: #88c0d0;
    background: #3b4252;
}

Footer {
    background: #3b4252;
    color: #eceff4;
}

FooterKey > .footer-key--key {
    background: #4c566a;
    color: #88c0d0;
}

FooterKey > .footer-key--description {
    background: #3b4252;
    color: #eceff4;
}

#search-input {
    border: tall #4c566a;
    background: #3b4252;
    color: #eceff4;
}

#search-input:focus {
    border: tall #88c0d0;
}

#channel-select {
    background: #3b4252;
    color: #eceff4;
}

#channel-select > SelectCurrent {
    background: #3b4252;
    color: #eceff4;
}

DataTable {
    background: #2e3440;
    color: #eceff4;
}

DataTable > .datatable--header {
    background: #3b4252;
    color: #88c0d0;
}

DataTable > .datatable--cursor {
    background: #88c0d0;
    color: #2e3440;
}

#detail-content {
    background: #2e3440;
    color: #eceff4;
}