Screen {
    background: #282a36;
    color: #f8f8f2;
}

Header {
    background: #44475a;
    color: #bd93f9;
    dock: top;
    height: 1;
}

HeaderTitle {
    color: #bd93f9;
    background: #44475a;
}

Footer {
    background: #44475a;
    color: #f8f8f2;
}

FooterKey > .footer-key--key {
    background: #6272a4;
    color: #bd93f9;
}

FooterKey > .footer-key--description {
    background: #44475a;
    color: #f8f8f2;
}

#search-input {
    border: tall #6272a4;
    background: #44475a;
    color: #f8f8f2;
}

#search-input:focus {
    border: tall #bd93f9;
}

#channel-select {
    background: #44475a;
    color: #f8f8f2;
}

#channel-select > SelectCurrent {
    background: #44475a;
    color: #f8f8f2;
}

DataTable {
    background: #282a36;
    color: #f8f8f2;
}

DataTable > .datatable--header {
    background: #44475a;
    color: #bd93f9;
}

DataTable > .datatable--cursor {
    background: #bd93f9;
    color: #282a36;
}

#detail-content {
    background: #282a36;
    color: #f8f8f2;
}